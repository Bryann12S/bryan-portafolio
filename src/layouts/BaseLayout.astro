---
// Layout compartido: <head> con fuentes y SEO, cabecera, <main>, pie y botón de WhatsApp.
import { Font } from 'astro:assets';
import SEO from '../components/layout/SEO.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
import { site } from '../data/site';
import { getLang, useTranslations } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Font cssVariable="--font-display" preload={[{ weight: 800 }]} />
    <Font cssVariable="--font-body" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-mono" />

    <SEO {...Astro.props} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t('layout.skipLink')}</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
