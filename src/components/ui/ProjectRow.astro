---
// Fila editorial de un proyecto para listados: miniatura, etiquetas y periodo, título, resumen y stack.
// Toda la fila es clicable a través del enlace del título (patrón de "enlace estirado").
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import ProjectTags from './ProjectTags.astro';
import { formatPeriod, getProjectUrl, type Project } from '../../lib/projects';
import { getLang } from '../../i18n/ui';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel: Heading = 'h3' } = Astro.props;
const { title, summary, stack, period, kind, cover } = project.data;
const lang = getLang(Astro.currentLocale);
const periodLabel = formatPeriod(period, lang);
---

<article class="project-row" data-kind={kind}>
  <div class="project-row__thumb">
    {
      cover ? (
        <Image
          src={cover}
          alt=""
          widths={[...[400, 640, 800].filter((w) => w < cover.width), cover.width]}
          sizes="(min-width: 56rem) 18rem, 100vw"
          loading="lazy"
        />
      ) : (
        <span class="project-row__placeholder" aria-hidden="true">
          BS<span>dev</span>
        </span>
      )
    }
  </div>

  <div class="project-row__meta">
    <ProjectTags project={project} />
    {periodLabel && <span class="project-row__period">{periodLabel}</span>}
  </div>

  <div class="project-row__body">
    <Heading class="project-row__title">
      <a href={getProjectUrl(project)}>{title}</a>
    </Heading>
    <p class="project-row__summary">{summary}</p>
  </div>

  <ul class="project-row__stack" role="list">
    {stack.map((tech) => <li>{tech}</li>)}
  </ul>

  <span class="project-row__arrow"><Icon name="arrow-right" size={28} /></span>
</article>

<style>
  .project-row {
    position: relative;
    display: grid;
    gap: var(--space-s);
    padding-block: var(--space-l);
    border-top: var(--border-width) solid var(--color-border);
  }

  /* Miniatura: proporción fija y anclada arriba para que se vea la cabecera de cada pantalla */
  .project-row__thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-m);
    background-color: var(--color-surface);
  }

  .project-row__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .project-row__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 800;
    color: var(--color-text-subtle);
  }

  .project-row__placeholder span {
    color: var(--color-accent);
  }

  .project-row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
  }

  .project-row__period {
    font-size: var(--text-small);
    color: var(--color-text-subtle);
  }

  .project-row__title {
    font-size: var(--text-h3);
  }

  .project-row__title a {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  /* El enlace del título cubre toda la fila */
  .project-row__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project-row__title a:focus-visible {
    outline: none;
  }

  .project-row:has(a:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
    border-radius: var(--radius-s);
  }

  .project-row__summary {
    margin-top: var(--space-2xs);
    color: var(--color-text-muted);
  }

  .project-row__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-s);
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-text-subtle);
  }

  .project-row__arrow {
    display: none;
  }

  /* Escritorio: miniatura a la izquierda; etiquetas, título y resumen al centro; stack a la derecha */
  @media (min-width: 56rem) {
    .project-row {
      grid-template-columns: 18rem minmax(0, 1fr) 10rem 2rem;
      grid-template-areas:
        'thumb meta stack arrow'
        'thumb body stack arrow';
      grid-template-rows: auto 1fr;
      align-items: start;
      gap: var(--space-xs) var(--space-l);
    }

    .project-row__thumb {
      grid-area: thumb;
    }

    .project-row__meta {
      grid-area: meta;
    }

    .project-row__body {
      grid-area: body;
    }

    .project-row__stack {
      grid-area: stack;
      flex-direction: column;
    }

    .project-row__arrow {
      grid-area: arrow;
      display: block;
      color: var(--color-text-subtle);
      transition:
        transform var(--duration-base) var(--ease-out),
        color var(--duration-fast) var(--ease-out);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .project-row:hover .project-row__title a {
      color: var(--color-accent);
    }

    .project-row:hover .project-row__arrow {
      color: var(--color-accent);
      transform: translateX(4px);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .project-row:hover .project-row__thumb :global(img) {
      transform: scale(1.03);
    }
  }
</style>
