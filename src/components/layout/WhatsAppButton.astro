---
// Botón flotante de WhatsApp. No se renderiza hasta que exista el número en site.ts,
// para no publicar un enlace roto.
import Icon from '../ui/Icon.astro';
import { site } from '../../data/site';
import { getLang, useTranslations } from '../../i18n/ui';

const t = useTranslations(getLang(Astro.currentLocale));
const number = site.contact.whatsapp;
const href = number
  ? `https://wa.me/${number}?text=${encodeURIComponent(t('whatsapp.message'))}`
  : null;
---

{
  href && (
    <a
      class="whatsapp"
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${t('whatsapp.label')} ${t('a11y.newTab')}`}
    >
      <Icon name="whatsapp" size={26} />
    </a>
  )
}

<style>
  .whatsapp {
    position: fixed;
    right: max(var(--gutter), env(safe-area-inset-right));
    bottom: max(var(--gutter), env(safe-area-inset-bottom));
    z-index: var(--z-floating);
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
    color: var(--color-on-accent);
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.45);
    transition:
      transform var(--duration-base) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .whatsapp:active {
    transform: scale(0.94);
  }

  @media (hover: hover) and (pointer: fine) {
    .whatsapp:hover {
      background-color: var(--color-accent-hover);
      transform: translateY(-2px);
    }
  }

  .whatsapp:focus-visible {
    outline-color: var(--color-text);
    outline-offset: 4px;
    border-radius: var(--radius-pill);
  }
</style>
