---
// Página temporal de la etapa 2: muestra el sistema de diseño (tipografía y color)
// para revisarlo. Se reemplaza por las secciones reales desde la etapa 3.
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const swatches = [
  { name: 'Fondo', token: '--color-bg' },
  { name: 'Superficie', token: '--color-surface' },
  { name: 'Superficie elevada', token: '--color-surface-raised' },
  { name: 'Borde', token: '--color-border-strong' },
  { name: 'Texto', token: '--color-text' },
  { name: 'Texto atenuado', token: '--color-text-muted' },
  { name: 'Texto sutil', token: '--color-text-subtle' },
  { name: 'Acento', token: '--color-accent' },
];
---

<BaseLayout noindex>
  <div class="container specimen">
    <section aria-labelledby="specimen-type">
      <p id="specimen-type" class="specimen__label">Tipografía</p>
      <p class="specimen__display">{site.name}</p>
      <h1>{site.role}</h1>
      <h2>Título de sección</h2>
      <h3>Título de tarjeta</h3>
      <p class="specimen__lead">
        Texto destacado en Inter. Sirve para introducir una sección con una frase clara y directa.
      </p>
      <p>
        Texto de párrafo en Inter con una medida máxima de 65 caracteres por línea para que la
        lectura sea cómoda en cualquier pantalla. <a href="#specimen-color">Enlace de ejemplo</a>.
      </p>
      <p class="specimen__mono">Astro · TypeScript · Angular · Spring Boot</p>
    </section>

    <section aria-labelledby="specimen-color">
      <p id="specimen-color" class="specimen__label">Color</p>
      <ul class="swatches" role="list">
        {
          swatches.map(({ name, token }) => (
            <li class="swatch">
              <span class="swatch__chip" style={`background: var(${token})`} />
              <span>{name}</span>
              <code>{token}</code>
            </li>
          ))
        }
      </ul>
      <p><button class="specimen__button" type="button">Botón de acento</button></p>
    </section>

    <p class="specimen__note">[PENDIENTE: página temporal del sistema de diseño]</p>
  </div>
</BaseLayout>

<style>
  .specimen {
    display: grid;
    gap: var(--space-section);
    padding-block: var(--space-section);
  }

  .specimen section {
    display: grid;
    gap: var(--space-m);
  }

  .specimen__label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-subtle);
  }

  .specimen__display {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 800;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    max-width: none;
  }

  .specimen__lead {
    font-size: var(--text-lead);
    color: var(--color-text-muted);
  }

  .specimen__mono {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-accent);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-s);
    padding: 0;
    list-style: none;
  }

  .swatch {
    display: grid;
    gap: var(--space-3xs);
    font-size: var(--text-small);
  }

  .swatch code {
    color: var(--color-text-subtle);
    font-size: var(--text-label);
  }

  .swatch__chip {
    height: 4rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-m);
  }

  .specimen__button {
    padding: var(--space-xs) var(--space-m);
    border: none;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 600;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .specimen__button:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .specimen__button:hover {
      background-color: var(--color-accent-hover);
    }
  }

  .specimen__note {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-text-subtle);
  }
</style>
