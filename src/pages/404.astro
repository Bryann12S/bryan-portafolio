---
// Página para direcciones que no existen. Netlify la sirve automáticamente con estado 404.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { getLang, useTranslations } from '../i18n/ui';

const t = useTranslations(getLang(Astro.currentLocale));
---

<BaseLayout title={t('notFound.title')} noindex>
  <section class="container not-found">
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1>{t('notFound.title')}</h1>
    <p class="not-found__text">{t('notFound.text')}</p>
    <div class="not-found__actions">
      <Button href="/">{t('notFound.home')}</Button>
      <Button href="/proyectos" variant="secondary">{t('notFound.projects')}</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    padding-block: var(--space-section);
  }

  .not-found__code {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 800;
    line-height: var(--leading-tight);
    color: var(--color-accent);
  }

  .not-found__text {
    font-size: var(--text-lead);
    color: var(--color-text-muted);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
</style>
